<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WPF half, and the sibling of `Chapbook.WinUI`. Both sit on the same
    `Chapbook` binding, which depends on no UI framework at all — so an app
    picks one of these and the boundary-crossing half is identical either
    way.

    Note what is *not* here: no SDK package reference, no runtime to
    deploy, no packaging switches. `UseWPF` is the whole of it. That is one
    of the two real differences from the WinUI project next door; the other
    is in `PagePeer`.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Chapbook.Wpf</RootNamespace>
    <AssemblyName>Chapbook.Wpf</AssemblyName>
    <Description>A WPF page view over the chapbook .NET binding</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chapbook\Chapbook.csproj" />
  </ItemGroup>

</Project>
