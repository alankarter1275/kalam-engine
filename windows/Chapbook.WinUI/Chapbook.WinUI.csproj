<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The WinUI half, and deliberately a separate assembly from `Chapbook`.

    Everything here is drawing and input; everything that crosses the C ABI
    is next door and depends on no UI framework at all. That split is the
    same one the engine makes about itself — a stack bundled into the thing
    a host embeds is the one a host cannot substitute — and it is what lets
    a WPF or MAUI app take the binding without taking WinUI with it.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Chapbook.WinUI</RootNamespace>
    <AssemblyName>Chapbook.WinUI</AssemblyName>
    <Description>A WinUI 3 page view over the chapbook .NET binding</Description>
    <!--
      A library, not an app: no bootstrapper, no MSIX, nothing that needs
      the Windows App SDK runtime present to *build*.
    -->
    <EnableMsixTooling>false</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Chapbook\Chapbook.csproj" />
  </ItemGroup>

</Project>
